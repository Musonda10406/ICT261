<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.customermanager.CustomerController"
      spacing="10"
      style="-fx-padding: 20;">

    <Label text="Customer Manager"/>

    <Label text="Customer Name"/>

    <TextField fx:id="nameField"
               promptText="Enter customer name"/>

    <Label text="Province"/>

    <ComboBox fx:id="provinceBox"
              promptText="Choose a province"/>

    <Button fx:id="saveButton"
            text="Save Customer"
            onAction="#handleSave"/>

    <Label fx:id="statusLabel"/>

    <TableView fx:id="customerTable">

        <columns>

            <TableColumn fx:id="nameColumn"
                         text="Customer Name"/>

            <TableColumn fx:id="provinceColumn"
                         text="Province"/>

        </columns>

    </TableView>

    <Button fx:id="deleteButton"
            text="Delete Customer"
            onAction="#handleDelete"/>

</VBox>